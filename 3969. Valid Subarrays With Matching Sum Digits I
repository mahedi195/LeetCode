

class Solution {
public:
    using ll = long long;

    bool check(ll sum, int x) {
        int last = sum % 10;

        while (sum >= 10) {
            sum = sum / 10;
        }
        int first = sum;

        if (first == x && last == x)
            return true;

        return false;
    }

    int countValidSubarrays(vector<int>& nums, int x) {
        int cnt = 0;

        for (int i = 0; i < nums.size(); i++) {
            ll sum = 0;
            for (int j = i; j < nums.size(); j++) {
                sum += nums[j];
                if (check(sum, x))
                    cnt++;
            }
        }

        return cnt;
    }
};
