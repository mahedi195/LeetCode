class Solution {
public:
    int maxArea(vector<int>& height) {
        using ll=long long;
        int n=height.size();
        int i=0,j=n-1;
        ll mx=0;
        while(i<j)
        {
            int w=j-i;
            int h=min(height[i],height[j]);
            ll area=w*h;
            mx=max(mx,area);

            if(height[i]<height[j]) i++;
            else j--;
        }

        return mx;
        
    }
};
