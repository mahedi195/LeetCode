class Solution {
public:
    int minRotations(string s) {
        int first_digit=s[0]-'0';
        int ans=0;
        ans+=min(first_digit, 10-first_digit);
        //cout<<"ans = "<<ans<<"\n";
        int n=s.size();
        for(int i=0;i<n-1;i++)
        {
            int ith_digit=s[i]-'0';
            int next_digit=s[i+1]-'0';
            //cout<<ith_digit<<" -> "<<next_digit<<" --->";
            int value=0;
            if(ith_digit<next_digit) value=min( abs(ith_digit-next_digit) , ith_digit+(10-next_digit) );
            else value=min( abs(ith_digit-next_digit) , next_digit+(10-ith_digit) );
            ans+=value;
            //cout<<"value = "<<value<<"\n";
        }

        return ans;
        
    }
};
