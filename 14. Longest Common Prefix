class Solution {
public:
    string longestCommonPrefix(vector<string>& strs) {
        int n=strs.size();

        if(n==0)
        return "";
        //string st=str[0];
        string ans="";
   
        for(int i=0; ;i++)  
        {
            //char ch=strs[0][i];

            for(int j=0;j<n;j++)
            {
                if(i>=strs[j].size() || strs[j][i]!=strs[0][i])
                {
                    return ans;
                }
            }
            ans+=strs[0][i];
        }


        return ans;
    }
};
